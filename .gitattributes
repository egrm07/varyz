# Normalize to LF in the repository; check out native on Windows.
* text=auto

*.py    text eol=lf
*.sql   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.command text eol=lf

*.png   binary
*.jpg   binary
*.ico   binary
*.onnx  binary
