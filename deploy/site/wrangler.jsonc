{
  "name": "varyzai",
  "account_id": "74b232b672a218e2653dc55478a9f883",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  // Pages that show a Cloud price run worker.js (it swaps in the visitor's local price),
  // and so does the Search Console ownership file, which must not redirect.
  "main": "worker.js",
  "assets": {
    "directory": "../../website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/pricing", "/pricing.html", "/google*.html"]
  },
  "routes": [
    { "pattern": "varyzai.com", "custom_domain": true }
  ]
}
