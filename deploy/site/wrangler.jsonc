{
  "name": "varyzai",
  "account_id": "74b232b672a218e2653dc55478a9f883",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  // All requests pass the worker; only public HTML responses contribute anonymous counters.
  // Price localization stays restricted to home/pricing; ownership proofs remain exact.
  "main": "worker.js",
  "assets": {
    "directory": "../../website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "varyzai.com", "custom_domain": true }
  ]
}
