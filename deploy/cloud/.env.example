# Example values only. Put real values in an untracked file outside this repo,
# or set them in your provider secret manager. No account has been provisioned.
VARYZ_CLOUD_PUBLIC_URL=http://127.0.0.1:8080
VARYZ_PADDLE_SANDBOX=true
VARYZ_PADDLE_API_KEY=
VARYZ_PADDLE_CLIENT_TOKEN=
VARYZ_PADDLE_WEBHOOK_SECRET=
# Paid recurring price IDs; create them without Paddle trial periods.
VARYZ_PADDLE_PRICE_IDS=
# Verification/password recovery mail; use a verified sending domain and secrets.
VARYZ_CLOUD_SMTP_HOST=
VARYZ_CLOUD_SMTP_PORT=587
VARYZ_CLOUD_SMTP_USERNAME=
VARYZ_CLOUD_SMTP_PASSWORD=
VARYZ_CLOUD_SMTP_FROM=
# Per-process PostgreSQL pool; total is replicas x this value plus deploy overlap.
VARYZ_CLOUD_DB_POOL_MAX=8
# Conservative cumulative preference-history admission limits per account.
# Choose tighter limits to fit the selected provider disk before public launch.
VARYZ_CLOUD_STORAGE_LIMIT_BYTES=1048576
VARYZ_CLOUD_CHANGE_LIMIT=10000
# Conservative initial enrollment: cumulative payload allowance ~100 MiB.
# Database indexes, backups and other tables still require disk monitoring.
VARYZ_CLOUD_MAX_ACCOUNTS=100
VARYZ_CLOUD_MAX_REGISTERED_CLIENTS=1000
VARYZ_CLOUD_MAX_EMAILS_PER_DAY=100
# Optional external shared backend; leave unset for persistent local SQLite.
# Use provider-required TLS and secret manager injection in production.
# VARYZ_CLOUD_POSTGRES_DSN=postgresql://user:password@host/database?sslmode=verify-full
