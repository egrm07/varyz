# Proposed replacement for /etc/logrotate.d/rsyslog, not an additional stanza.
# Keep the current Ubuntu log inventory; validate against the host before activation.
/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/cron.log
{
    su root adm
    create
    daily
    rotate 28
    maxage 28
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
