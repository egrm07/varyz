        "default": null,
        "title": "Expected Publication Revision"
      }
    },
    "required": [
      "expected_thread_version",
      "answer"
    ],
    "title": "Reply",
    "type": "object"
  },
  "Decline": {
    "additionalProperties": false,
    "properties": {
      "expected_thread_version": {
        "minimum": 0,
        "title": "Expected Thread Version",
        "type": "integer"
      },
      "explanation": {
        "default": "",
        "maxLength": 4000,
        "title": "Explanation",
        "type": "string"
      }
    },
    "required": [
      "expected_thread_version"
    ],
    "title": "Decline",
    "type": "object"
  },
  "Withdraw": {
    "additionalProperties": false,
    "properties": {
      "expected_thread_version": {
        "minimum": 0,
        "title": "Expected Thread Version",
        "type": "integer"
      }
    },
    "required": [
      "expected_thread_version"
    ],
    "title": "Withdraw",
    "type": "object"
  },
  "tools": {
    "shared_projects": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "Projects",
      "type": "object"
    },
    "shared_join": {
      "additionalProperties": false,
      "properties": {
        "invite_id": {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$",
