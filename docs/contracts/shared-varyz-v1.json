{
  "Preview": {
    "$defs": {
      "SourceRef": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "rule",
              "answer",
              "workflow"
            ],
            "title": "Kind",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\w.-]+$",
            "title": "Id",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "id",
          "version"
        ],
        "title": "SourceRef",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "project": {
        "maxLength": 128,
        "minLength": 1,
        "title": "Project",
        "type": "string"
      },
      "label": {
        "maxLength": 80,
        "minLength": 1,
        "title": "Label",
        "type": "string"
      },
      "selection": {
        "items": {
          "$ref": "#/$defs/SourceRef"
        },
        "maxItems": 500,
        "title": "Selection",
        "type": "array"
      },
      "expected_publication_revision": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Publication Revision"
      }
    },
    "required": [
      "project",
      "label",
      "selection"
    ],
    "title": "Preview",
    "type": "object"
  },
  "Publish": {
    "additionalProperties": false,
    "properties": {
      "preview_id": {
        "maxLength": 128,
        "minLength": 16,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Preview Id",
        "type": "string"
      },
      "invited_email": {
        "maxLength": 254,
        "minLength": 3,
        "title": "Invited Email",
        "type": "string"
      },
      "source_fingerprint": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Source Fingerprint",
        "type": "string"
      },
      "level": {
        "default": "consult",
        "enum": [
          "consult",
          "contribute",
          "decide"
        ],
        "title": "Level",
        "type": "string"
      },
      "fill_gaps": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fill Gaps"
      }
    },
    "required": [
      "preview_id",
      "invited_email",
      "source_fingerprint"
    ],
    "title": "Publish",
    "type": "object"
  },
  "Update": {
    "additionalProperties": false,
    "properties": {
      "preview_id": {
        "maxLength": 128,
        "minLength": 16,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Preview Id",
        "type": "string"
      },
      "expected_publication_revision": {
        "minimum": 0,
        "title": "Expected Publication Revision",
        "type": "integer"
      }
    },
    "required": [
      "preview_id",
      "expected_publication_revision"
    ],
    "title": "Update",
    "type": "object"
  },
  "Invite": {
    "additionalProperties": false,
    "properties": {
      "invited_email": {
        "maxLength": 254,
        "minLength": 3,
        "title": "Invited Email",
        "type": "string"
      },
      "level": {
        "default": "consult",
        "enum": [
          "consult",
          "contribute",
          "decide"
        ],
        "title": "Level",
        "type": "string"
      },
      "fill_gaps": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Fill Gaps"
      }
    },
    "required": [
      "invited_email"
    ],
    "title": "Invite",
    "type": "object"
  },
  "State": {
    "additionalProperties": false,
    "properties": {
      "status": {
        "enum": [
          "active",
          "paused",
          "deleted"
        ],
        "title": "Status",
        "type": "string"
      },
      "expected_publication_revision": {
        "minimum": 0,
        "title": "Expected Publication Revision",
        "type": "integer"
      }
    },
    "required": [
      "status",
      "expected_publication_revision"
    ],
    "title": "State",
    "type": "object"
  },
  "MemberState": {
    "additionalProperties": false,
    "properties": {
