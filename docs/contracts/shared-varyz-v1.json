        "minimum": 0,
        "title": "Expected Revision",
        "type": "integer"
      }
    },
    "required": [
      "expected_revision"
    ],
    "title": "MemberState",
    "type": "object"
  },
  "Reply": {
    "additionalProperties": false,
    "properties": {
      "expected_thread_version": {
        "minimum": 0,
        "title": "Expected Thread Version",
        "type": "integer"
      },
      "answer": {
        "maxLength": 4000,
        "minLength": 1,
        "title": "Answer",
        "type": "string"
      },
      "remember_project": {
        "default": false,
        "title": "Remember Project",
        "type": "boolean"
      },
      "publish_to_share": {
        "default": false,
        "title": "Publish To Share",
        "type": "boolean"
      },
      "expected_publication_revision": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
